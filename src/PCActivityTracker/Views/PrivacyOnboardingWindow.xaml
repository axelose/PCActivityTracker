<Window x:Class="PCActivityTracker.Views.PrivacyOnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Activity Tracker — 初期設定" Width="650" Height="690"
        MinWidth="600" MinHeight="620" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Background="{DynamicResource Canvas}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="記録を始める前に" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="このアプリは操作中のアプリやWebサイトを、このWindowsユーザーのPC内だけに保存します。外部サーバーへActivityデータを送信しません。"
                       FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="0,10,0,20" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="RecordingCheck" Content="アプリ名、プロセス名、Webドメイン、利用時間を記録する" IsChecked="True" FontWeight="SemiBold" />
                        <TextBlock Text="完全URLやタイトルを許可しなくても、どのアプリとドメインを使ったかは記録されます。" TextWrapping="Wrap" Foreground="{DynamicResource MutedInk}" Margin="24,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="詳細情報（既定はOFF）" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <CheckBox x:Name="UrlsCheck" Content="完全URLを記録する（クエリとフラグメントは除去）" Margin="0,5" />
                        <CheckBox x:Name="PageTitlesCheck" Content="Webページタイトルを記録する" Margin="0,5" />
                        <CheckBox x:Name="WindowTitlesCheck" Content="ウィンドウタイトルを記録する" Margin="0,5" />
                        <CheckBox x:Name="CreatorsCheck" Content="YouTubeチャンネル名・Twitch配信者名を記録する" Margin="0,5" />
                        <TextBlock Text="タイトルには文書名、メール件名、チャット相手などが含まれる場合があります。必要な項目だけ有効にしてください。" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <TextBlock Text="保存期間" FontSize="17" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBox x:Name="RetentionText" Text="90" Width="90" Padding="8" />
                            <TextBlock Text="日（1〜3650日）。期限切れデータはバックアップからも削除されます。" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource MutedInk}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="設定は後から「設定・プライバシー」で変更できます。" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Style="{DynamicResource SecondaryButton}" Content="記録せず開始" Click="ContinueWithoutRecording_Click" Margin="0,0,10,0" />
            <Button Grid.Column="2" Style="{DynamicResource PrimaryButton}" Content="この設定で開始" Click="Start_Click" />
        </Grid>
    </Grid>
</Window>
